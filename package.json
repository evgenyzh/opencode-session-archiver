{
  "name": "@evgenyzh/opencode-session-archiver",
  "version": "0.2.0",
  "description": "Reduce an OpenCode session to its native compaction summary.",
  "license": "MIT",
  "author": "Evgeny Zhuravlev",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evgenyzh/opencode-session-archiver.git"
  },
  "bugs": {
    "url": "https://github.com/evgenyzh/opencode-session-archiver/issues"
  },
  "homepage": "https://github.com/evgenyzh/opencode-session-archiver#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "session",
    "archive",
    "compaction"
  ],
  "engines": {
    "node": ">=22",
    "opencode": ">=1.18.21 <2"
  },
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/tui.tsx --format esm --dts --out-dir dist --clean --external @opencode-ai/plugin --external @opencode-ai/sdk --external @opentui/core --external @opentui/keymap --external @opentui/solid --external bun:sqlite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike": "node test/isolated-spike.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/keymap": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.21",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "24.12.2",
    "tsup": "8.5.1",
    "typescript": "5.8.2",
    "vitest": "4.1.11"
  }
}
